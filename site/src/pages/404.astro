---
/**
 * 自訂 404 頁面（starlight({ disable404Route: true }) 時由這裡接手）。
 * hero 按鈕的站內連結會由 src/routeData.ts 自動加上 base。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: '找不到頁面',
		template: 'splash',
		editUrl: false,
		pagefind: false,
		hero: {
			title: '404',
			tagline: '找不到這個頁面。可能是網址打錯了，或這部分內容還沒推出。',
			actions: [
				{ text: '回到首頁', link: '/', icon: 'right-arrow' },
				{ text: '看學習路線', link: '/roadmap/', variant: 'minimal' },
			],
		},
	}}
/>
